---
 optima-service-angular/src/index.html | 23 ++++++++++++++++++++++-
 optima-service-angular/src/main.ts    |  6 ++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/optima-service-angular/src/index.html b/optima-service-angular/src/index.html
index 5018474..8851d7a 100644
--- a/optima-service-angular/src/index.html
+++ b/optima-service-angular/src/index.html
@@ -8,7 +8,28 @@
   <meta name="yandex-verification" content="e0a7ece593631315" />
   <link rel="icon" type="image/x-icon" href="/assets/logo/favicon.png">
 
-  
+  <!-- Автовосстановление при сбое загрузки critical JS-модуля (нестабильный
+       хостинг иногда рвёт соединение на отдельном chunk-файле — без этого
+       приложение не запускается вовсе). При сбое перезагружаем страницу один
+       раз; флаг сбрасывается в main.ts после успешного старта приложения,
+       чтобы не зациклиться, если проблема не временная. -->
+  <script>
+    (function () {
+      window.addEventListener('error', function (e) {
+        var t = e.target;
+        if (t && t.tagName === 'SCRIPT' && t.type === 'module') {
+          try {
+            if (!sessionStorage.getItem('chunkRetry')) {
+              sessionStorage.setItem('chunkRetry', '1');
+              location.reload();
+            }
+          } catch (_) {}
+        }
+      }, true);
+    })();
+  </script>
+
+
 <!-- Yandex.Metrika counter -->
 <script type="text/javascript">
     (function(m,e,t,r,i,k,a){
diff --git a/optima-service-angular/src/main.ts b/optima-service-angular/src/main.ts
index f23d53e..5c7d389 100644
--- a/optima-service-angular/src/main.ts
+++ b/optima-service-angular/src/main.ts
@@ -3,4 +3,10 @@ import { appConfig } from './app/app.config';
 import { AppComponent } from './app/app';
 
 bootstrapApplication(AppComponent, appConfig)
+  .then(() => {
+    // Успешный старт — снимаем флаг «уже пробовали перезагрузиться из-за
+    // сбоя загрузки чанка» (см. index.html), чтобы следующий сбой (в другой
+    // сессии/вкладке) тоже получил свою одну попытку авто-восстановления.
+    try { sessionStorage.removeItem('chunkRetry'); } catch (_) {}
+  })
   .catch((err) => console.error(err));
