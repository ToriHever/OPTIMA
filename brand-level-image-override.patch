hero.image в brand-repair-data.ts (интерфейс общий для appliances/computers/av
— it-brand-repair-data.ts и av-brand-repair-data.ts переиспользуют его же).
Необязательное поле: если задано у конкретного бренда — показывается вместо
общего фото вида техники (deviceData.hero.image).

brand-repair.html: [imageUrl]="brandData.hero.image || deviceData.hero.image".
Пока ни у одного бренда image не заполнен — поведение не меняется, страницы
показывают то же фото вида техники, что и раньше.

Проверено: временно задал brandData.hero.image для Apple/ноутбуки — страница
показала переопределённое фото, у Lenovo/ноутбуки (без переопределения и без
реального файла для вида техники) блок остался корректно скрыт. Тестовое
значение убрано перед коммитом.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .../remont-bytovoy-tekhniki/brand-repair/brand-repair-data.ts  | 3 +++
 .../remont-bytovoy-tekhniki/brand-repair/brand-repair.html     | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair-data.ts b/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair-data.ts
index 4abbb87..eddb31a 100644
--- a/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair-data.ts
+++ b/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair-data.ts
@@ -7,6 +7,9 @@ export interface BrandRepairData {
     titleAccent: string;
     subtitle: string;
     features: string[];
+    // Своё фото для этого бренда+вида техники. Необязательное — если не
+    // задано, страница показывает общее фото вида техники (deviceData.hero.image).
+    image?: string;
   };
 }
 
diff --git a/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair.html b/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair.html
index 5324184..9f00b0c 100644
--- a/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair.html
+++ b/optima-service-angular/src/app/features/remont-bytovoy-tekhniki/brand-repair/brand-repair.html
@@ -5,7 +5,7 @@
     [brandName]="brandData.brandName"
     [deviceName]="brandData.hero.titleAccent"
     [deviceLabel]="deviceData.hero.titleAccent"
-    [imageUrl]="deviceData.hero.image"
+    [imageUrl]="brandData.hero.image || deviceData.hero.image"
     [features]="brandData.hero.features"
     [backPath]="backPath"
     [backLabel]="sectionLabel"
