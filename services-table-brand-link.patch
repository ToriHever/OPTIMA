В app-services-table добавлены опциональные ServiceCategory.link/linkLabel:
если заданы, под таблицей текущей вкладки показывается кнопка-переход
(routerLink). Поля опциональны — на главной странице (дефолтные категории
без link) поведение не меняется.

На странице бренда кнопка ведёт на страницу «техника по бренду»
(/remont-.../{device}/{brand}) для активного вида техники — используется
уже имеющийся BrandCategoryLink.path.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .../src/app/features/brands/brand-hub/brand-hub.ts         | 4 +++-
 .../shared/components/services-table/services-table.html   | 6 ++++++
 .../shared/components/services-table/services-table.scss   | 5 +++++
 .../app/shared/components/services-table/services-table.ts | 7 ++++++-
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/optima-service-angular/src/app/features/brands/brand-hub/brand-hub.ts b/optima-service-angular/src/app/features/brands/brand-hub/brand-hub.ts
index 094cf16..c305684 100644
--- a/optima-service-angular/src/app/features/brands/brand-hub/brand-hub.ts
+++ b/optima-service-angular/src/app/features/brands/brand-hub/brand-hub.ts
@@ -88,7 +88,9 @@ export class BrandHubPage implements OnInit {
         name: item.name,
         price: item.priceFrom,
         duration: item.description
-      }))
+      })),
+      link: c.path,
+      linkLabel: `Перейти к разделу «${c.device.name}»`
     }));
   }
 
diff --git a/optima-service-angular/src/app/shared/components/services-table/services-table.html b/optima-service-angular/src/app/shared/components/services-table/services-table.html
index 170cd15..9f6124b 100644
